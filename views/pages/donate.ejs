<div class="container">
  <%- include header.ejs %>
       <div class = "col-sm-6 col-lg-6 col-md-6" style="background-color:#FFF8A4">
      <form id ="regform" action = "/donate" method = "post" style="margin:0; padding:0">
        <div class="form-group">
          <label>First Name</label>
          <input type="text" name="fname" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Last Name</label>
          <input type="text" name="lname" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Age</label>
          <input type="number" name="age" min="18" max="60" placeholder="18–60" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Phone Number</label>
          <input type="tel" name="number" pattern="[0-9]{10}" placeholder="10-digit number" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Place</label>
          <input type="text" name="place" style="text-align:center" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Gender</label>
          <select name="gender" class="form-control" required>
            <option value="">-- Select --</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Blood Group</label>
          <select name="bgroup" class="form-control" required>
            <option value="">-- Select --</option>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
          </select>
        </div>

        <div class="form-group text-right">
          <button type="submit" class="btn btn-primary btn-lg">Submit</button>
        </div>
      </form>
    </div>
    <div class="col-md-6 col-lg-6 col-sm-6" style="background-image:url('images/share.jpg'); background-size:contain; background-size:cover;">
      <div style="height:680px">
      </div>
    </div>
  </div>
<%-include footer.ejs %>
