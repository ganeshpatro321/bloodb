<div class="container motivation-page">
  <%- include header.ejs %>

  <section class="motivation-hero">
    <div class="row">
      <div class="col-md-7 col-sm-7">
        <h1>Your blood can be someone's second chance.</h1>
        <p>
          A short visit from you can bring hope to patients, families, and
          communities when they need it most.
        </p>
        <a href="/donate" class="btn btn-default btn-lg">Become a Donor</a>
        <a href="/maps" class="btn btn-danger btn-lg">Find a Blood Bank</a>
      </div>
      <div class="col-md-5 col-sm-5">
        <img src="/images/donor2.png" class="img-responsive" alt="Blood donor illustration">
      </div>
    </div>
  </section>

  <section class="motivation-section">
    <h2>Why your donation matters</h2>
    <div class="row">
      <div class="col-md-4 col-sm-4">
        <div class="motivation-card">
          <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
          <h3>Give Hope</h3>
          <p>Your donation supports people facing surgery, illness, injury, and other emergencies.</p>
        </div>
      </div>
      <div class="col-md-4 col-sm-4">
        <div class="motivation-card">
          <span class="glyphicon glyphicon-time" aria-hidden="true"></span>
          <h3>Make Time Count</h3>
          <p>A small part of your day can make a meaningful difference in another person's life.</p>
        </div>
      </div>
      <div class="col-md-4 col-sm-4">
        <div class="motivation-card">
          <span class="glyphicon glyphicon-user" aria-hidden="true"></span>
          <h3>Strengthen Community</h3>
          <p>Regular donors help blood banks stay ready for both daily needs and unexpected crises.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="motivation-quote">
    <blockquote>Someone is waiting for the kindness only you can give.</blockquote>
    <a href="/donate" class="btn btn-danger btn-lg">Donate Blood Today</a>
  </section>

  <%- include footer.ejs %>
</div>
